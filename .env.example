# Copy to .env and adjust if needed. All values have defaults in docker-compose.yml.

# SereneDB image tag. Use a multi-arch release (works on Intel and Apple Silicon).
SERENEDB_TAG=26.09.1.3
SERENE_UI_TAG=26.05.1

# Host ports. Change if 7890 / 6543 are already taken on your machine.
SERENEDB_PORT=7890
SERENE_UI_PORT=6543
