# Independent integration stack. No credentials are copied from other worktrees.
COMPOSE_PROJECT_NAME=schubki-integration
SERENEDB_TAG=26.09.1.3
SERENE_UI_TAG=26.05.1
# Alternate loopback ports avoid the existing stack's 7890/6543/8000.
SERENEDB_PORT=17890
SERENE_UI_PORT=16543
MCP_PUBLISHED_PORT=18000

# sql uses main's bgl_logs, openstack_logs, ownership. sample is legacy/opt-in.
MCP_DATASET_BACKEND=sql
# For direct Python commands only; obtain explicitly from the DB owner.
SERENEDB_DSN=
# Optional override for MCP in Docker. Empty uses the isolated Compose service.
# Do not set this to an existing database until read-only testing is approved.
SERENEDB_DOCKER_DSN=
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=18000
MCP_PATH=/mcp
