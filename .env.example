# Required: use the exact connection string supplied by the organizers.
# No host, database name, user, password, or dataset schema is assumed here.
SERENEDB_DSN=

# Optional Docker-specific DSN. On macOS, use host.docker.internal instead of
# 127.0.0.1 when the MCP service must reach a separately running host container.
SERENEDB_DOCKER_DSN=

# Local MCP transport. Docker Compose overrides these with the same HTTP defaults.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

# Docker publishes only to loopback by default. Keep this value for local use and
# SSH tunneling. Do not set 0.0.0.0 unless a firewall/private network and an
# authenticated TLS reverse proxy have already been configured.
MCP_PUBLISH_HOST=127.0.0.1
MCP_PUBLISHED_PORT=8000
